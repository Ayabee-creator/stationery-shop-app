<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_light">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <!-- Brand Name -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary_light" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stationery Za"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_violet" />

                </LinearLayout>

                <!-- Cart Badge -->
                <FrameLayout
                    android:id="@+id/btnCart"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_chip_category"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_agenda"
                        android:contentDescription="Cart" />

                </FrameLayout>

                <!-- Profile / Logout -->
                <FrameLayout
                    android:id="@+id/btnProfile"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_chip_category"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:contentDescription="Profile" />

                </FrameLayout>

            </LinearLayout>

            <!-- SEARCH BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <EditText
                    android:id="@+id/edtSearch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_search_bar"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="12dp"
                    android:hint="Search supplies or press Ctrl+K..."
                    android:textSize="14sp"
                    android:textColorHint="@color/text_hint_light"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:importantForAutofill="no" />

            </LinearLayout>

            <!-- STUDENT DISCOUNT BANNER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_banner_student"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎓"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Student Discount Active! 15% OFF with .edu email"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/banner_text" />

            </LinearLayout>

            <!-- HERO SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_section"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Everything for\nyour semester."
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:lineSpacingMultiplier="1.2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Automated supply shopping for students"
                    android:textSize="13sp"
                    android:textColor="#D4BCFA"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExploreKits"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Explore Kits"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="10dp"
                        app:backgroundTint="@color/white"
                        android:textColor="@color/primary_violet" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProducts"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="All Products"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:layout_marginStart="10dp"
                        app:cornerRadius="10dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:strokeColor="@color/white"
                        android:textColor="@color/white" />

                </LinearLayout>

            </LinearLayout>

            <!-- CATEGORY SECTION TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shop by Category"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_light"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="12dp" />

            <!-- CATEGORY PILLS (HorizontalScrollView) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="20dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/categoryChipsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Category chips will be added dynamically -->
                    <!-- Fallback static chips -->
                    <TextView
                        android:id="@+id/chipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="All"
                        android:textSize="13sp"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_chip_selected"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipPens"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Pens &amp; Pencils"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary_light"
                        android:background="@drawable/bg_chip_category"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipNotebooks"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Notebooks"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary_light"
                        android:background="@drawable/bg_chip_category"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipArt"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Art Supplies"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary_light"
                        android:background="@drawable/bg_chip_category"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipOffice"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Office"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary_light"
                        android:background="@drawable/bg_chip_category"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipPaper"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Paper"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary_light"
                        android:background="@drawable/bg_chip_category" />

                </LinearLayout>

            </HorizontalScrollView>

            <!-- FEATURED PRODUCTS TITLE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Featured Products"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_light" />

                <TextView
                    android:id="@+id/txtSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See All"
                    android:textSize="13sp"
                    android:textColor="@color/primary_violet"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- PRODUCT GRID (RecyclerView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:clipToPadding="false" />

            <!-- STUDY KIT BUILDER SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Build Your Study Kit"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_light" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Create a custom semester starter pack and save 20%"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary_light"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuildKit"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Start Building"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/accent_mint" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@color/surface_light"
        android:elevation="8dp"
        android:gravity="center_vertical">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_today"
                android:contentDescription="Home"
                app:tint="@color/primary_violet" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="11sp"
                android:textColor="@color/primary_violet" />

        </LinearLayout>

        <!-- Products -->
        <LinearLayout
            android:id="@+id/navProducts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="Products"
                app:tint="@color/text_hint_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Products"
                android:textSize="11sp"
                android:textColor="@color/text_hint_light" />

        </LinearLayout>

        <!-- Orders -->
        <LinearLayout
            android:id="@+id/navOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:contentDescription="Orders"
                app:tint="@color/text_hint_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Orders"
                android:textSize="11sp"
                android:textColor="@color/text_hint_light" />

        </LinearLayout>

        <!-- Logout -->
        <LinearLayout
            android:id="@+id/navLogout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Logout"
                app:tint="@color/text_hint_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textSize="11sp"
                android:textColor="@color/text_hint_light" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
