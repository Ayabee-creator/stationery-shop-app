<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas_light">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        android:background="@color/surface_light"
        android:elevation="2dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            android:background="@drawable/bg_chip_category" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="All Products"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_light"
            android:paddingStart="14dp" />

        <ImageView
            android:id="@+id/btnFilter"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="Filter"
            android:background="@drawable/bg_chip_category" />

    </LinearLayout>

    <!-- SEARCH BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@color/surface_light">

        <EditText
            android:id="@+id/edtSearchProducts"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_bar"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="12dp"
            android:hint="Search products..."
            android:textSize="14sp"
            android:textColorHint="@color/text_hint_light"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:inputType="text"
            android:importantForAutofill="no" />

    </LinearLayout>

    <!-- CATEGORY FILTER CHIPS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:background="@color/surface_light">

        <LinearLayout
            android:id="@+id/categoryChipsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="All"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_chip_selected"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipPens"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Pens &amp; Pencils"
                android:textSize="12sp"
                android:textColor="@color/text_primary_light"
                android:background="@drawable/bg_chip_category"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipNotebooks"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Notebooks"
                android:textSize="12sp"
                android:textColor="@color/text_primary_light"
                android:background="@drawable/bg_chip_category"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipArt"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Art Supplies"
                android:textSize="12sp"
                android:textColor="@color/text_primary_light"
                android:background="@drawable/bg_chip_category"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipOffice"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Office"
                android:textSize="12sp"
                android:textColor="@color/text_primary_light"
                android:background="@drawable/bg_chip_category"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipPaper"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Paper"
                android:textSize="12sp"
                android:textColor="@color/text_primary_light"
                android:background="@drawable/bg_chip_category" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- PRODUCT COUNT & RESULTS -->
    <TextView
        android:id="@+id/txtResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading products..."
        android:textSize="13sp"
        android:textColor="@color/text_secondary_light"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!-- PRODUCT LIST (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false" />

</LinearLayout>
